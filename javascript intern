console.log("\n\n===== CAPSTONE PROJECT =====");
console.log("--- Initializing Inventory System ---");

// 1. Data & input initialization
const inventory = [
  { name: "Laptop", price: 800 },
  { name: "Mouse", price: 25 },
];

// Input lena, bad input par loop me continue/break
function getValidProduct() {
  const defaults = ["Monitor", "150"];
  for (let attempt = 1; attempt <= 3; attempt++) {
    const rawName = ask("Enter product name:", defaults[0]);
    const rawPrice = ask("Enter product price:", defaults[1]);

    if (rawName === null || rawPrice === null) break; // user ne cancel kiya
    if (!rawName.trim()) {
      console.log("Name khali hai, dobara try karo.");
      continue;
    }
    const price = Number(rawPrice); // explicit conversion
    if (Number.isNaN(price) || price <= 0) {
      console.log("Price valid number nahi hai, dobara try karo.");
      continue;
    }
    return { name: rawName.trim(), price };
  }
  return null;
}

const newProduct = getValidProduct();
if (newProduct) {
  inventory.push(newProduct);
  console.log(`[Prompt executed: User adds "${newProduct.name}" at "$${newProduct.price}"]`);
} else {
  console.log("[No valid product added]");
}

// 2. Conditional evaluation: category badge
function getCategory(price) {
  switch (true) {
    case price >= 500:
      return "Premium";
    case price >= 100:
      return "Standard";
    default:
      return "Budget";
  }
}

// 3. Loop se search (break use karke)
function findProduct(list, productName) {
  let found = null;
  for (const item of list) {
    if (!item || typeof item.price !== "number") continue; // bad data skip
    if (item.name.toLowerCase() === productName.toLowerCase()) {
      found = item;
      break;
    }
  }
  return found;
}

// 4. Functions & scope: regular + arrow
function totalInventoryValue(list) {
  let sum = 0; // local scope
  for (const item of list) sum += item.price;
  return sum;
}
const applyTax = (price, taxRate = 0.18) => +(price * (1 + taxRate)).toFixed(2);
const applyDiscount = (price, discount = 0.1) => +(price * (1 - discount)).toFixed(2);

// 5. Array methods
console.log("\n--- Processing Inventory Roster (forEach) ---");
inventory.forEach((item) => {
  console.log(`* Item: ${item.name} ($${item.price}) -> Category: ${getCategory(item.price)}`);
});

console.log("\n--- Financial Analytics ---");
console.log(`Total Inventory Value: $${totalInventoryValue(inventory)}`);

const affordable = inventory.filter((item) => item.price < 200).map((item) => item.name);
console.log("Filtered Affordable Items (Under $200):", affordable);

const report = inventory.map((item) => `${item.name.toUpperCase()}: $${item.price}`);
console.log("Formatted Report List:", report);

// Extra: search + tax/discount demo
const found = findProduct(inventory, "monitor");
if (found) {
  console.log(`\nSearch: ${found.name} mila.`);
  console.log(`  With 18% tax: $${applyTax(found.price)}`);
  console.log(`  With 10% discount: $${applyDiscount(found.price)}`);
}
